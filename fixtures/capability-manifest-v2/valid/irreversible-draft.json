{
  "schema_version": "2",
  "name": "mail-draft",
  "version": "1.0.0",
  "origin": {
    "kind": "builtin"
  },
  "scopes": [
    "mail:draft:outbox"
  ],
  "inputs": [
    {
      "name": "path",
      "type": "string",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "content",
      "type": "string"
    }
  ],
  "effect": "write_irreversible",
  "mode": "draft",
  "risk_tier": "high",
  "network": {
    "egress": "none"
  },
  "credentials": [],
  "execution_identity": "agent_builder",
  "undo": {
    "button_ref": "discard-draft"
  }
}
