{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grant",
  "title": "Grant v1",
  "description": "One grant per task (R3): scope, budget, expiry, allowed risk tiers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "scope", "budget", "expires_at", "allowed_risk_tiers"],
  "properties": {
    "schema_version": { "const": "1" },
    "task_id": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repos", "paths"],
      "properties": {
        "repos": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_usd", "max_tool_calls"],
      "properties": {
        "max_usd": { "type": "number", "exclusiveMinimum": 0 },
        "max_tool_calls": { "type": "integer", "minimum": 1 }
      }
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "allowed_risk_tiers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["low", "medium", "high", "payments"] } }
  }
}
