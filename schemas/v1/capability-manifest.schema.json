{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-manifest",
  "title": "Capability manifest v1",
  "description": "Declares one capability. Rule R1: a manifest with neither an undo button reference nor reversal steps is invalid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "scopes", "inputs", "outputs", "undo", "risk_tier"],
  "properties": {
    "schema_version": { "const": "1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "inputs": { "$ref": "#/$defs/fields" },
    "outputs": { "$ref": "#/$defs/fields" },
    "undo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "button_ref": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "reversal_steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
      },
      "anyOf": [{ "required": ["button_ref"] }, { "required": ["reversal_steps"] }]
    },
    "risk_tier": { "enum": ["low", "medium", "high", "payments"] }
  },
  "$defs": {
    "fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["string", "number", "integer", "boolean", "object", "array"] },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
