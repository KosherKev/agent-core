{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extension-request",
  "title": "Extension request v1",
  "description": "Raised when the agent lacks a capability. An undo plan is mandatory (R1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "missing_capability", "why", "proposed_approach", "scopes_wanted", "undo_plan"],
  "properties": {
    "schema_version": { "const": "1" },
    "missing_capability": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "why": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "proposed_approach": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "scopes_wanted": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "undo_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "button_ref": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "reversal_steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
      },
      "anyOf": [{ "required": ["button_ref"] }, { "required": ["reversal_steps"] }]
    }
  }
}
