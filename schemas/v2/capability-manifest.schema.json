{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-manifest-v2",
  "title": "Capability manifest v2",
  "description": "ADR-0007 D2. Describes one capability and grants nothing. risk_tier is derived from effect; irreversible and money capabilities are draft only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "origin", "scopes", "inputs", "outputs", "effect", "mode", "risk_tier", "network", "credentials", "execution_identity", "undo"],
  "properties": {
    "schema_version": { "const": "2" },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "builtin" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "server_id", "source_url", "pinned_commit", "lockfile_sha256", "protocol_version"],
          "properties": {
            "kind": { "const": "mcp" },
            "server_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
            "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "pinned_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "lockfile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "protocol_version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      ]
    },
    "definition_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tool_definition": { "$ref": "#/$defs/tool_definition" },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$" }
    },
    "inputs": { "$ref": "#/$defs/fields" },
    "outputs": { "$ref": "#/$defs/fields" },
    "effect": { "enum": ["read", "write_reversible", "write_irreversible", "money"] },
    "mode": { "enum": ["execute", "draft"] },
    "risk_tier": { "enum": ["low", "medium", "high", "payments"] },
    "network": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["egress"],
          "properties": { "egress": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["egress", "hosts"],
          "properties": {
            "egress": { "const": "allowlist" },
            "hosts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
              }
            }
          }
        }
      ]
    },
    "credentials": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" }
    },
    "execution_identity": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
    "undo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "button_ref": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "reversal_steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
        "not_applicable_read_only": { "const": true }
      },
      "anyOf": [{ "required": ["button_ref"] }, { "required": ["reversal_steps"] }, { "required": ["not_applicable_read_only"] }]
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "required": ["origin"], "properties": { "origin": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "builtin" } } } } },
      "then": { "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" } } }
    },
    {
      "if": { "type": "object", "required": ["origin"], "properties": { "origin": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "mcp" } } } } },
      "then": { "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}\\.[A-Za-z0-9_.-]{1,128}$" } } }
    },
    {
      "if": { "type": "object", "required": ["origin"], "properties": { "origin": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "mcp" } } } } },
      "then": { "required": ["definition_hash", "tool_definition"] }
    },
    {
      "if": { "type": "object", "required": ["effect"], "properties": { "effect": { "const": "read" } } },
      "then": { "properties": { "risk_tier": { "const": "low" } } }
    },
    {
      "if": { "type": "object", "required": ["effect"], "properties": { "effect": { "const": "write_reversible" } } },
      "then": { "properties": { "risk_tier": { "const": "medium" } } }
    },
    {
      "if": { "type": "object", "required": ["effect"], "properties": { "effect": { "const": "write_irreversible" } } },
      "then": { "properties": { "risk_tier": { "const": "high" }, "mode": { "const": "draft" } } }
    },
    {
      "if": { "type": "object", "required": ["effect"], "properties": { "effect": { "const": "money" } } },
      "then": { "properties": { "risk_tier": { "const": "payments" }, "mode": { "const": "draft" } } }
    },
    {
      "if": { "type": "object", "required": ["undo"], "properties": { "undo": { "type": "object", "required": ["not_applicable_read_only"] } } },
      "then": { "properties": { "effect": { "const": "read" } } }
    }
  ],
  "$defs": {
    "fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["string", "number", "integer", "boolean", "object", "array"] },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "tool_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "inputSchema"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "annotations": { "type": "object" },
        "title": { "type": "string" },
        "icons": { "type": "array" }
      }
    }
  }
}
