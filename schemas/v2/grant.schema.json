{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grant-v2",
  "title": "Grant v2",
  "description": "ADR-0007 D4. The v1 grant plus the capabilities one task may use (name, pinned definition hash, call cap). The list may be empty; there is no wildcard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "scope", "budget", "expires_at", "allowed_risk_tiers", "capabilities"],
  "properties": {
    "schema_version": { "const": "2" },
    "task_id": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repos", "paths"],
      "properties": {
        "repos": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_usd", "max_tool_calls"],
      "properties": {
        "max_usd": { "type": "number", "exclusiveMinimum": 0 },
        "max_tool_calls": { "type": "integer", "minimum": 1 }
      }
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "allowed_risk_tiers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["low", "medium", "high", "payments"] } },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "definition_hash", "max_calls"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
          "definition_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "max_calls": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
